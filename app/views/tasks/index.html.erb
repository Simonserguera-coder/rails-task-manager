<h1>My Tasks</h1>

<%= link_to "Add a task", new_task_path %>

<ul>
  <% @tasks.each do |task| %>
    <li>
      <%= link_to task.title, task_path(task) %>

      - <%= task.completed %>

      <%= link_to "Edit", edit_task_path(task) %>

      <%= button_to "Delete", task_path(task), method: :delete %>
    </li>
  <% end %>
</ul>
